<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DefineConstants>$(DefineConstants);WBB_WARUDO_SDK</DefineConstants>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <!-- WarudoSdkRoslynDir: the RoslynCSharp/Plugin folder of the Unity modtool SDK, e.g.
       <UnityProject>/Library/PackageCache/app.warudo.modtool@<hash>/Packages/RoslynCSharp/Plugin -->
  <Target Name="CheckWarudoSdkRoslynDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="'$(WarudoSdkRoslynDir)' == '' OR !Exists('$(WarudoSdkRoslynDir)/Microsoft.CodeAnalysis.dll')"
           Text="Pass -p:WarudoSdkRoslynDir=&lt;modtool SDK&gt;/Packages/RoslynCSharp/Plugin" />
  </Target>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../Assets/StudioRaming/WarudoBatchBuilder/Editor/Shared/WbbWarudoTypeCatalog.cs" Link="WbbWarudoTypeCatalog.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(WarudoSdkRoslynDir)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(WarudoSdkRoslynDir)/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
    <Reference Include="System.Collections.Immutable"><HintPath>$(WarudoSdkRoslynDir)/System.Collections.Immutable.dll</HintPath></Reference>
    <Reference Include="System.Reflection.Metadata"><HintPath>$(WarudoSdkRoslynDir)/System.Reflection.Metadata.dll</HintPath></Reference>
  </ItemGroup>
</Project>
